# Local development (copy to .env) — placeholders only, never commit real values
DATABASE_URL=postgres://hawmess_tickets:change-me-in-production@localhost:5433/hawmess_tickets
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
PORT=4000
CORS_ORIGIN=http://localhost:3100
STORAGE_DIR=./storage          # ticket attachments (outside the web root; served only through the authenticated API)

# Seed (npm run seed)
ADMIN_EMAIL=admin@hawmess.com
ADMIN_PASSWORD=Admin@123       # change immediately in any shared environment
SEED_DEMO=true                 # false = no demo people/tickets

# Email notifications — optional. Leave SMTP_HOST empty to disable email (in-app notifications always work).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<address>, SMTP_PASSWORD=<16-char APP password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Hawmess <no-reply@your-company.com>
