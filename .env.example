# ---- Docker Compose (copy to .env) — placeholders only, never commit real values ----
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
POSTGRES_PASSWORD=replace-me
RUN_SEED=true            # creates roles, categories, SLA defaults and the admin; set to false after the first start
SEED_DEMO=true           # demo people / tickets / projects. Set to false for a clean production install
ADMIN_EMAIL=admin@your-company.com
ADMIN_PASSWORD=choose-a-strong-password
# Optional email (leave SMTP_HOST empty to run with in-app notifications only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Barid-IN <no-reply@your-company.com>

# Public port of the web app (host side). 3000 is left free on purpose.
FRONTEND_PORT=3100
# Database. The compose file creates this Postgres for you (db/user: barid_in_tickets, host port 5433).
# To use your own Postgres instead, uncomment and paste its URL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# ---- Internal audio / video calls (WebRTC) — placeholders only; never commit real TURN credentials ----
# Browsers need HTTPS (or http://localhost) to access the camera / microphone, so serve the app over HTTPS in production (WSS is then automatic).
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302      # comma-separated; set to empty to disable
# TURN relay for users behind strict firewalls / symmetric NAT (recommended for production, e.g. coturn):
# WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# WEBRTC_TURN_SECRET=<coturn static-auth-secret>   # preferred: short-lived per-user credentials are generated by the API
# WEBRTC_TURN_TTL_SECONDS=3600
# WEBRTC_TURN_USERNAME=   # alternative to the secret: static long-term credentials
# WEBRTC_TURN_CREDENTIAL=
# CALL_RING_TIMEOUT_MS=45000        # unanswered calls become "missed" after this long
# CALL_RECONNECT_GRACE_MS=20000     # how long a dropped participant may reconnect before the call ends
